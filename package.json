{
  "name": "saas-starter-kit",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "predev": "docker compose up -d",
    "dev": "concurrently -n web,api,stripe -c blue,green,magenta \"npm run dev -w @app/frontend\" \"npm run dev -w @app/backend\" \"node scripts/dev-stripe.mjs\"",
    "stripe:listen": "stripe listen --events customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,customer.subscription.paused,customer.subscription.resumed --forward-to localhost:3000/api/webhooks/stripe",
    "db:generate": "npm run db:generate -w @app/shared",
    "db:migrate": "npm run db:migrate -w @app/shared",
    "build": "npm run build -w @app/frontend",
    "lint": "eslint",
    "test": "npm test --workspaces --if-present",
    "check": "npm run lint && npm run typecheck --workspaces --if-present && npm test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5"
  },
  "overrides": {
    "@fastify/static": "10.1.3"
  }
}
